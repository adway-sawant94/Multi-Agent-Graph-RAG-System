        {
          "type": "entity",
          "entity_type": "Concept",
          "description": "Protected client records containing personally identifiable information shared between Company X and Supplier B."
        }
      ],
      [
        "Personally Identifiable Information (PII)",
        {
          "type": "entity",
          "entity_type": "Concept",
          "description": "Sensitive customer details including full names, social security numbers, and banking information."
        }
      ],
      [
        "Corporate Data Sharing Protocol",
        {
          "type": "entity",
          "entity_type": "Regulation",
          "description": "The governing agreement outline that establishes data sharing and protection requirements between the organizations."
        }
      ],
      [
        "chunk_company_x_policy_1",
        {
          "type": "chunk",
          "text": "ase servers. Company X mandates that any external partner must implement encryption at rest, but cybersecurity audits are outsourced to the partner's local jurisdiction requirements.\"\n}",
          "source_file": "company_x_policy.json",
