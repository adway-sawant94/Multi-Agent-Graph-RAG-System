        "chunk_supplier_b_policy_0",
        {
          "type": "chunk",
          "text": "{\n  \"company_name\": \"Supplier B\",\n  \"document_title\": \"Data Processing & Jurisdiction Agreement\",\n  \"content\": \"Supplier B processes transaction records for major international partners, including Company X. Supplier B stores all received Customer Data in its primary servers located in a Foreign Jurisdiction (specifically, Jurisdiction F). Supplier B undergoes a periodic Cybersecurity Audit to verify compliance with local laws. This audit is conducted by a Third-Party Auditor appointed by Jurisdiction F's corporate regulator. Jurisdiction F does not have a formal data protection adequacy treat",
          "source_file": "supplier_b_policy.json",
          "doc_type": "json"
        }
      ],
      [
        "Jurisdiction F",
        {
          "type": "entity",
          "entity_type": "Location",
          "description": "The foreign jurisdiction where Supplier B's primary servers are located."
        }
      ],
      [
        "Cybersecurity Audit",
        {
          "type": "entity",
          "entity_type": "Audit",
          "description": "A periodic assessment undergone by Supplier B to verify compliance with local laws."
        }
      ],
      [
        "Third-Party Auditor",
        {
          "type": "entity",
          "entity_type": "Organization",
          "description": "An independent auditor appointed by the corporate regulator of Jurisdiction F to conduct cybersecurity audits."
        }
      ],
      [
        "Corporate Regulator",
        {
          "type": "entity",
          "entity_type": "Organization",
          "description": "The government body in Jurisdiction F responsible for appointing the third-party auditor."
        }
      ],
      [
        "chunk_supplier_b_policy_1",
        {
          "type": "chunk",
          "text": "iction F's corporate regulator. Jurisdiction F does not have a formal data protection adequacy treaty with the US, and local regulatory laws permit local government agencies to inspect foreign-owned datasets under national security provisions.\"\n}",
          "source_file": "supplier_b_policy.json",
          "doc_type": "json"
        }
      ],
