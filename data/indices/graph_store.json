        {
          "type": "entity",
          "entity_type": "Organization",
          "description": "The primary corporate entity initiating the partnership and sharing customer data."
        }
      ],
      [
        "Supplier B",
        {
          "type": "entity",
          "entity_type": "Organization",
          "description": "An external partner responsible for storing and managing customer transaction records in their database servers."
        }
      ],
      [
